# docker compose 用的环境变量（.env 已被 .gitignore 忽略）。
# 推荐直接跑 ./compose-up.sh：缺的密钥/口令会自动生成到 ./secrets（0600），
# 再把值渲染进 .env 与 admin/conf/app.conf；手工 cp 本文件时要自己填。

# ── MySQL ────────────────────────────────────────────────────────────────
# root 口令。compose-up.sh 会生成并写回这里；手工部署请换掉占位符。
MYSQL_ROOT_PASSWORD=change-me-please
# 后端专用账号（不是 root）；首次初始化 / mysql-init 服务会建好并授权。
MYSQL_DATABASE=bee_admin
MYSQL_USER=bra
MYSQL_PASSWORD=change-me-please

# ── 镜像 ─────────────────────────────────────────────────────────────────
# compose 里的 bra-backend / bra-web 取这个 tag；离线包会预填成发布 tag。
BRA_VERSION=latest

# ── 运行身份 ─────────────────────────────────────────────────────────────
# 后端以这个 uid/gid 运行，才能读到 600 的 admin/conf/app.conf 和写 ./data/bra。
# 默认由 compose-up.sh 取当前用户（id -u / id -g）；手工部署按需填写。
APP_UID=1000
APP_GID=1000
TZ=Asia/Shanghai

# ── HTTP / HTTPS ─────────────────────────────────────────────────────────
# 默认 HTTP 对外 8081。配置好域名证书后，compose-up.sh 会自动切到 80/443。
HTTP_PORT=8081
HTTPS_PORT=443
# 真实域名（留空 = 不启用 HTTPS，仅 HTTP）。证书放 ./certs/fullchain.pem 与 privkey.pem。
SERVER_NAME=
