# BRA 单机 HTTPS 站点（由 docker-compose.tls.yml 挂到 nginx 容器）
# 官方 nginx 镜像 entrypoint 会对本文件做 envsubst：${SERVER_NAME} / ${BACKEND_UPSTREAM}
# 之外的 nginx 变量（$host/$remote_addr 等）不要加大括号。
#
# 证书只从这里读：/etc/nginx/certs/fullchain.pem、/etc/nginx/certs/privkey.pem
# （宿主机 ./certs 挂进来；域名证书需自行配置，不由脚本生成）。
server {
    listen 80;
    server_name ${SERVER_NAME};

    # 以后要接 ACME HTTP-01 时，把 challenge 放这里；当前证书手动配置
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    index index.html;

    # 上传/导入请求体与后端管理端上限保持一致（后端是 8 MiB）
    client_max_body_size 8m;

    # HSTS 只在 HTTPS 模板加；按 add_header 继承规则，下面自带 add_header 的
    # location 必须重复这一行，否则不会继承 server 级。
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    gzip_vary on;

    # SPA 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端接口反代；X-Real-IP 必须透传（登录记录取真实 IP 靠它）
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 导入/导出是长耗时请求：前端给 /api/v1/imports 120s、后端放宽到 180s，
        # nginx 默认 proxy_read_timeout 60s 会先断开，这里按 180s 留足余量。
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # 大导出/附件不落响应缓冲：Compose 里 /var/cache/nginx 是 32MB tmpfs，
        # 缓冲写满 proxy_temp 会直接失败；只关响应缓冲，请求缓冲保持默认。
        proxy_buffering off;
    }

    # 带 hash 的静态资源长缓存；index.html 不缓存
    location ~* \.(js|css|woff2?|svg|png|jpg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}
