[app]
name = bee-rust-admin-test
http_addr = 127.0.0.1:0
log_level = warn
# 头像测试落盘位置（相对 admin/，被 .gitignore 覆盖）
upload_dir = target/test-uploads
# 固定盐：测试里同一 id 每次都编成同一个短串（换盐会让断言里的短串漂移）
hashids_salt = bee-admin-test-salt
hashids_min_len = 8
snowflake_worker = 1
snowflake_dc = 1
# email / phone 的落库加密密钥。测试用**固定**值：库每轮重建，密文不需要跨轮可解；
# 真随机会让「库里是密文而非明文」这类断言没法复现（后端必须与它同源，缺了不启动）
encrypt_key = base64:YmVlLWFkbWluLXRlc3Qta2V5LTMyLWJ5dGVzLW9rISE=

[db]
dsn = mysql://root:placeholder@127.0.0.1:3306/bee_admin_test

[jwt]
secret = test-secret-0123456789abcdefghijklmnop
expire_hours = 1

[auth]
# 窗口 10 分钟对测试太长，但限流状态在内存里、随进程重启清零：
# 需要「解封」的用例换个进程即可（见 api_v12_test 的 B9 段）
max_fail = 5
lock_minutes = 10

[seed]
initial_admin_password = admin123
