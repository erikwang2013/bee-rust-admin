[app]
name = bee-rust-admin-test
http_addr = 127.0.0.1:0
log_level = warn
# 头像测试落盘位置（相对 admin/，被 .gitignore 覆盖）
upload_dir = target/test-uploads

[db]
dsn = mysql://root:placeholder@127.0.0.1:3306/bee_admin_test

[jwt]
secret = test-secret-0123456789abcdefghijklmnop
expire_hours = 1

[auth]
# 窗口 10 分钟对测试太长，但限流状态在内存里、随进程重启清零：
# 需要「解封」的用例换个进程即可（见 api_v12_test 的 B9 段）
max_fail = 5
lock_minutes = 10

[seed]
initial_admin_password = admin123
