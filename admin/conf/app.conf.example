[app]
name = bee-rust-admin
http_addr = 127.0.0.1:8080
log_level = info
# 上传文件根目录（头像分片上传落在 uploads/avatar/<月份>/ 下），可用绝对路径。
# 进程需要对它可写；老版本的头像（uploads/avatar/<id>.png）继续从这个目录读，不用迁移。
upload_dir = uploads
# 对外 id（hashids 短串）的盐：**生产必须换成随机串**，改盐 = 所有已发出的短串作废
hashids_salt = change-me-to-a-random-salt
# 短串最小长度（越长越不易被看出来是递增的）
hashids_min_len = 8
# 雪花发号器节点号 / 数据中心号（各 0-31）。**多实例部署时每个进程必须不同**，
# 否则会发出重复 id（写入时才以唯一键冲突暴露）
snowflake_worker = 1
snowflake_dc = 1
# admin 的 email / phone 落库加密密钥（AES-256-GCM）。**生产必须换成随机 32 字节**：
#   openssl rand -base64 32   →  encrypt_key = base64:<那串>
# 也认 64 位 hex 或 32 字节字面量。这是**必填**项，缺了/留成占位符会拒绝启动。
# ⚠️ 换密钥 = 库里已加密的 email/phone 全部解不开（没有救援，改前先备份）；
#    密钥本身丢了同理，所以启动时会把迁移前的明文备份进 admin_email_phone_backup 表。
encrypt_key = base64:change-me-32-byte-random-key

[db]
dsn = mysql://user:password@127.0.0.1:3306/bee_admin

[jwt]
# 至少 32 字符，且不能是 changeme（否则拒绝启动）
secret = change-me-to-a-random-string-of-32-chars
expire_hours = 24

[auth]
# 登录失败锁定：lock_minutes 分钟内失败 max_fail 次即锁定；填 0 关闭锁定
max_fail = 5
lock_minutes = 10
# 登录图形验证码（poster-rust：点击 / 旋转 / 滑块，每次随机切）。false = 关闭。
# 默认开：登录是唯一没有鉴权的写入口，验证码是加在限流之前的一道；
# 代价只是每次登录多一次点选/拖动。验证码答错**不计入**上面的失败次数（不会因此锁号）。
# ⚠️ 升级已有部署时：新前端才会提交验证码凭据，若暂时不重建前端，先在这里写 false，
#    否则老前端的登录会被判 400（验证码错误）。
captcha = true
# 滑块**拖拽轨迹**校验（poster-rust 2.0 的 trajectory）。默认 false。
# 开启后滑块答案必须带轨迹（插件默认阈值：≥4 个采样点、300–5000ms 总耗时、
# 轨迹线性度 ≤0.99），只提交裸数值的客户端一律判失败；阈值不在我们这边调。
# 新前端**总是**上报轨迹（开关关着时后端不看），所以开它不用重发前端。
# ⚠️ 症状：用户「拖得很快」（<300ms 甩过去）会被判机器 —— 滑块怎么拖都提示
#    「验证码错误」。要放宽得改插件侧的 min_duration_ms，遇到再调。
captcha_trajectory = false

[log]
# 日志保留天数（login_log / audit_log / job_log 执行记录）；0 = 永久保留。
# 启动时清一遍，之后由内置定时任务 log_retention 每天清一次
retain_days = 90

[job]
# 定时任务总开关：false = 不启动调度循环（任务不会自动跑），但「手动触发一次」仍然可用
enabled = true

[backup]
# 数据库备份（内置任务 db_backup，走 mysqldump；恢复步骤见 docs/usage.md「5.10 备份与恢复」）
# 备份目录：留空 = {upload_dir}/backups；放独立磁盘时填绝对路径。
# 备份文件权限是 0600（dump 含全库数据与口令哈希），恢复靠手工 mysql < dump。
dir =
# 保留份数：每跑完一次删掉最旧的多余备份；**必须 >= 1**，填 0/负数拒绝启动
keep = 7

[export]
# 导出中心（异步导出）成品保留天数：发起导出后到这个天数，记录与文件一起清掉。
# 清理由内置任务 export_clean 每天跑一次（依赖 [job] enabled=true；调度关了可在定时任务页
# 手动触发 export_clean）；**必须 >= 1**（0 等于文件立刻过期），
# 文件落在 {upload_dir}/exports/，权限 0600。见 docs/usage.md「3.12 导出中心」
retain_days = 7

[attach]
# 附件中心（项 5）的每人总量配额（MB）：按该上传人的 SUM(size) 算，超了预检接口回
# 400 `attach.quota_exceeded`。0 = 不限；负数拒绝启动。
# 单文件 10 MB 上限与类型白名单**写死在代码里**（api/attach.rs），不做配置项。
quota_mb = 200

[security]
# 请求安全扫描（security-rust 32 个检测器：SQLi / XSS / 命令注入 / Log4Shell …）。
# 扫 URL、几个请求头、以及 ≤64KB 的 JSON 请求体（multipart 上传不读）。
#   off      = 只报告（默认）：命中写 audit_log + 日志，请求照常走
#   high     = 扫描等级到 HIGH 就 403 + err = "security.blocked"
#   critical = 只拦 CRITICAL
# 默认 off 是刻意的：扫描是「有攻击迹象就记一笔」，不是 WAF —— 密码里带 ' or 1=1--、
# 公告里贴代码片段这类误报会把人拦在门外。要开拦截，先跑一段 off 看过命中与误报再定。
scan = off

[apidoc]
# 接口文档站（apidoc-rust）。**默认 false**：文档页会把整个后台的接口面暴露出来
# （含请求/响应结构），它是开发/交付工具，不该跟着生产实例一起对外。
# 挂载点是 /apidoc（UI）与 /apidoc/api.json（数据）。
enabled = false
# enabled = true 时**必填**：文档站口令（缺了/空着直接拒绝启动，理由同 encrypt_key）。
# 换 token 是 POST /apidoc/auth（口令走请求体）；token 带在 query 上、默认 24 小时有效
# —— 等价于一个**可重放的通行证**（抓到一次到期前都能用）。所以只在可信网络
# （内网 / 跳板机）里开，别对着公网。
password =

[seed]
# 首次启动（admin 表为空）时用它创建内置超管 admin；库非空时本键被忽略。
# **照抄示例值上线 = 公网后台用示例口令**，跑起来第一件事就是改。
# 太弱（不足 8 位 / 少于两类字符）会在**那一次**启动时被拒绝并给出错误 —— 校验故意
# 不放在配置加载期，免得存量部署（conf 里还是老口令）换个值之前起不来。
initial_admin_password = change-me-please-1
