[app]
name = bee-rust-admin
http_addr = 127.0.0.1:8080
log_level = info
# 上传文件根目录（头像落在这里的 avatar/ 下），可用绝对路径
upload_dir = uploads
# 对外 id（hashids 短串）的盐：**生产必须换成随机串**，改盐 = 所有已发出的短串作废
hashids_salt = change-me-to-a-random-salt
# 短串最小长度（越长越不易被看出来是递增的）
hashids_min_len = 8
# 雪花发号器节点号 / 数据中心号（各 0-31）。**多实例部署时每个进程必须不同**，
# 否则会发出重复 id（写入时才以唯一键冲突暴露）
snowflake_worker = 1
snowflake_dc = 1
# admin 的 email / phone 落库加密密钥（AES-256-GCM）。**生产必须换成随机 32 字节**：
#   openssl rand -base64 32   →  encrypt_key = base64:<那串>
# 也认 64 位 hex 或 32 字节字面量。这是**必填**项，缺了/留成占位符会拒绝启动。
# ⚠️ 换密钥 = 库里已加密的 email/phone 全部解不开（没有救援，改前先备份）；
#    密钥本身丢了同理，所以启动时会把迁移前的明文备份进 admin_email_phone_backup 表。
encrypt_key = base64:change-me-32-byte-random-key

[db]
dsn = mysql://user:password@127.0.0.1:3306/bee_admin

[jwt]
# 至少 32 字符，且不能是 changeme（否则拒绝启动）
secret = change-me-to-a-random-string-of-32-chars
expire_hours = 24

[auth]
# 登录失败锁定：lock_minutes 分钟内失败 max_fail 次即锁定；填 0 关闭锁定
max_fail = 5
lock_minutes = 10

[log]
# 日志保留天数（login_log / audit_log / job_log 执行记录）；0 = 永久保留。
# 启动时清一遍，之后由内置定时任务 log_retention 每天清一次
retain_days = 90

[job]
# 定时任务总开关：false = 不启动调度循环（任务不会自动跑），但「手动触发一次」仍然可用
enabled = true

[seed]
initial_admin_password = admin123
