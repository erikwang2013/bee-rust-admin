# BRA 前端容器内的 nginx 站点（由官方镜像 entrypoint 做 envsubst 生成）
# 只替换 ${BACKEND_UPSTREAM}；nginx 自身的变量（$host/$remote_addr 等）不加大括号，不受影响
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # CSV 导入走后端 /api/v1/imports；管理端请求体上限已配成 8 MiB，nginx 默认只有 1m，
    # 会先回 413。两处保持一致（multipart 边界等留余量），不是又放宽了业务上限。
    client_max_body_size 8m;

    # 点击劫持 / MIME 嗅探防护。注意 add_header 继承规则：下面任何自带 add_header 的
    # location 都不再继承这三行，必须自己重复一遍。
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;

    # 压缩。**这一行不是可选项**：首屏那几个 JS 未压缩 1.1 MB，gzip 后 ~364 kB（3 倍差），
    # 而 nginx 默认只压 text/html —— 不显式列出 js/css，压缩等于没开。
    # 别用 gzip_static 指望构建产物预压缩：vite 没生成 .gz 文件。
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1024;   # 小文件压了反而更大
    gzip_vary on;           # 让中间缓存按 Accept-Encoding 分别缓存

    # SPA 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端接口反代；X-Real-IP 必须透传（登录记录取真实 IP 靠它）
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        # 请求体不落 nginx 缓冲：导入/上传直接流给后端，避免撑满 /var/cache/nginx/client_temp（Compose 下是 32MB tmpfs）
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 导入/导出是长耗时请求：前端与后端都给 /api/v1/imports 180s，
        # nginx 默认 proxy_read_timeout 60s 会先断开，这里按 180s 留足余量。
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # 大导出/附件不落响应缓冲：Compose 里 /var/cache/nginx 是 32MB tmpfs，
        # 缓冲写满 proxy_temp 会直接失败。
        proxy_buffering off;
    }

    # 带 hash 的静态资源长缓存；index.html 不缓存
    # （两处都有自己的 add_header，所以安全头必须重复，否则不再继承 server 级）
    location ~* \.(js|css|woff2?|svg|png|jpg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
