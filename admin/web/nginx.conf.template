# BRD 前端容器内的 nginx 站点（由官方镜像 entrypoint 做 envsubst 生成）
# 只替换 ${BACKEND_UPSTREAM}；nginx 自身的变量（$host/$remote_addr 等）不加大括号，不受影响
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端接口反代；X-Real-IP 必须透传（登录记录取真实 IP 靠它）
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 带 hash 的静态资源长缓存；index.html 不缓存
    location ~* \.(js|css|woff2?|svg|png|jpg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
