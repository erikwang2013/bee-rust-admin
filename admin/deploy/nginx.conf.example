# bee-rust 管理后台 —— nginx 站点配置（对外 8081）
#
# 本机 nginx 是 /usr/local/nginx 的 LNMP 自编译版，主配置末行是 `include vhost/*.conf;`，
# 所以安装方式（需要 root）：
#   sudo cp admin/deploy/nginx.conf.example /usr/local/nginx/conf/vhost/bee-admin.conf
#   sudo nginx -t && sudo systemctl reload nginx     # 或 sudo nginx -s reload
#
# 说明：
#   - 静态资源 = 前端构建产物 admin/web/dist（cd admin/web && pnpm build 生成）
#   - /api/ 反代到本机 Rust 服务（systemd 单元里监听 127.0.0.1:8080）
#   - X-Real-IP 必须透传，登录记录取客户端 IP 靠它
server {
    listen 8081;
    server_name _;

    root /home/wwwroot/bee-rust-admin/admin/web/dist;
    index index.html;

    # CSV 导入走后端 /api/v1/imports；管理端请求体上限已配成 8 MiB，nginx 默认只有 1m，
    # 会先回 413。两处保持一致（multipart 边界等留余量），不是又放宽了业务上限。
    client_max_body_size 8m;

    # 点击劫持 / MIME 嗅探防护。注意 add_header 继承规则：下面任何自带 add_header 的
    # location 都不再继承这三行，必须自己重复一遍。
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;

    # 压缩。**这一行不是可选项**：首屏那几个 JS 未压缩 1.1 MB，gzip 后 ~364 kB（3 倍差），
    # 而 nginx 默认只压 text/html —— 不显式列出 js/css，压缩等于没开。
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1024;   # 小文件压了反而更大
    gzip_vary on;           # 让中间缓存按 Accept-Encoding 分别缓存

    # SPA 路由回退：刷新深层路径时交给前端路由处理
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端接口
    location /api/ {
        # 不带尾斜杠：原样转发完整 URI（/api/v1/auth/login 保持 /api/v1/auth/login）
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 导入/导出是长耗时请求：前端给 /api/v1/imports 120s、后端放宽到 180s，
        # nginx 默认 proxy_read_timeout 60s 会先断开，这里按 180s 留足余量。
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # 大导出/附件不落响应缓冲：Compose 里 /var/cache/nginx 是 32MB tmpfs，
        # 缓冲写满 proxy_temp 会直接失败；只关响应缓冲，请求缓冲保持默认。
        proxy_buffering off;
    }

    # `/metrics`（Prometheus 文本）**故意不反代**：后端只监听 127.0.0.1，默认谁都不给看。
    # 要接 Prometheus 时自己加一段（示例，注意按需限制来源 IP）：
    #   location = /metrics { proxy_pass http://127.0.0.1:8080; allow 10.0.0.0/8; deny all; }

    # 前端产物带 hash 的静态资源可长缓存；index.html 不缓存
    # （两处都有自己的 add_header，所以安全头必须重复，否则不再继承 server 级）
    location ~* \.(js|css|woff2?|svg|png|jpg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
